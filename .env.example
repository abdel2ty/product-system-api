# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication database
MONGODB_URI=mongodb://127.0.0.1:27017/product-system

# Tokens — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google Sheets (service account, shared as Editor on the spreadsheet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=

# Optional: restrict accepted image URLs to your own Cloudinary cloud
CLOUDINARY_CLOUD_NAME=
